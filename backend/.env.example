# 複製成 .env（.gitignore 已排除），本地開發用。
# 連本機的 PostgreSQL（正式環境的資料庫在 EC2 上，不對外開放）。
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/manga_record
ENVIRONMENT=dev

# 本機開發先隨便產一組（例如 python -c "import secrets; print(secrets.token_urlsafe(48))"）。
# 正式環境這個值改存 AWS Secrets Manager，不會出現在任何 .env 檔案裡（見 infra/terraform/secrets.tf 的 jwt_secret）。
JWT_SECRET=<random-local-dev-secret>
